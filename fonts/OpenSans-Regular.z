from fpdf import FPDF
import os
from django.conf import settings

pdf = FPDF()

# Path to .z file generated by makefont.py
font_z_path = os.path.join(settings.BASE_DIR, "fonts", "OpenSans-Regular.z")

# Register and use the custom font
pdf.add_font("OpenSans", "", font_z_path, uni=True)
pdf.set_font("OpenSans", size=10)

pdf.add_page()
pdf.cell(0, 10, "This is a test in OpenSans", ln=True)

# Save PDF
output_path = os.path.join(settings.BASE_DIR, "test_opensans.pdf")
pdf.output(output_path)

print(f"✅ PDF generated at {output_path}")
